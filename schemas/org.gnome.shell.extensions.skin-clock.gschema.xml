<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.skin-clock" path="/org/gnome/shell/extensions/skin-clock/">
    <key name="skin" type="s">
      <default>'classic'</default>
      <summary>Clock skin</summary>
    </key>
    <key name="size" type="i">
      <range min="120" max="800"/>
      <default>320</default>
      <summary>Clock diameter</summary>
    </key>
    <key name="opacity" type="d">
      <range min="0.2" max="1.0"/>
      <default>1.0</default>
      <summary>Clock opacity</summary>
    </key>
    <key name="show-seconds" type="b">
      <default>true</default>
      <summary>Show the second hand</summary>
    </key>
    <key name="smooth-seconds" type="b">
      <default>true</default>
      <summary>Smooth second hand</summary>
    </key>
    <key name="visible" type="b">
      <default>true</default>
      <summary>Show the clock</summary>
    </key>
    <key name="x" type="i">
      <default>80</default>
      <summary>Horizontal position</summary>
    </key>
    <key name="y" type="i">
      <default>100</default>
      <summary>Vertical position</summary>
    </key>
	<key name="refresh-ms" type="i">
		  <range min="16" max="1000"/>
		  <default>50</default>
		  <summary>Clock refresh interval in milliseconds</summary>
		</key>
  </schema>
</schemalist>
